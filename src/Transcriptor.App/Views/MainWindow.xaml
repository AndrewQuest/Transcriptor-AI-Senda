<Window x:Class="Transcriptor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="{DynamicResource 'Senda — Dictado local'}" Width="1120" Height="820" MinWidth="940" MinHeight="650" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="228" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="18,30,18,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="12,0,0,38">
          <StackPanel Orientation="Horizontal">
            <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="12" Width="39" Height="39" Margin="0,0,11,0">
              <Path Data="M 11,17 L 11,23 M 19,10 L 19,29 M 27,15 L 27,24" Stroke="{DynamicResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Border>
            <TextBlock Text="senda" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="29" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,-3,0,0" />
          </StackPanel>
          <TextBlock Text="{DynamicResource 'Un espacio para tu voz.'}" Style="{StaticResource Caption}" Margin="0,13,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <RadioButton x:Name="HomeNav" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="True" Checked="HomeClicked" AutomationProperties.Name="{DynamicResource 'Inicio'}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /></Grid.ColumnDefinitions><Path Data="M 2,10 L 10,3 L 18,10 M 5,8 L 5,19 L 15,19 L 15,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="22" /><TextBlock Grid.Column="1" Text="{DynamicResource 'Inicio'}" VerticalAlignment="Center" /></Grid>
          </RadioButton>
          <RadioButton x:Name="HistoryNav" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="HistoryClicked" AutomationProperties.Name="{DynamicResource 'Historial'}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /></Grid.ColumnDefinitions><Path Data="M 4,4 L 17,4 L 17,19 L 4,19 Z M 7,8 L 14,8 M 7,12 L 14,12 M 7,16 L 11,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="20" Height="22" /><TextBlock Grid.Column="1" Text="{DynamicResource 'Historial'}" VerticalAlignment="Center" /></Grid>
          </RadioButton>
          <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="SettingsClicked" AutomationProperties.Name="{DynamicResource 'Ajustes'}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /></Grid.ColumnDefinitions><Path Data="M 4,3 L 4,19 M 11,3 L 11,19 M 18,3 L 18,19 M 1,7 L 7,7 M 8,15 L 14,15 M 15,9 L 21,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" Width="22" Height="22" /><TextBlock Grid.Column="1" Text="{DynamicResource 'Ajustes'}" VerticalAlignment="Center" /></Grid>
          </RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="12,0">
          <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource Positive}" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource 'Solo en tu equipo'}" Foreground="{DynamicResource Positive}" FontSize="12" /></StackPanel>
          <TextBlock Text="{DynamicResource 'El audio se descarta al terminar. Tus palabras se quedan contigo.'}" Style="{StaticResource Caption}" FontSize="11" LineHeight="17" Margin="0,12,0,24" />
          <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource Subtle}" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="38,32,34,22">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <Grid>
          <StackPanel x:Name="HomePanel">
            <TextBlock Text="{DynamicResource 'Tu voz, a tu ritmo.'}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource 'Deja que las palabras salgan. Senda se encarga de escribirlas.'}" Foreground="{DynamicResource Muted}" Margin="0,0,0,28" />
            <Border Style="{StaticResource Card}" Background="{DynamicResource HeroSurface}" Padding="27,30" CornerRadius="23">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{DynamicResource 'Mantén. Habla. Suelta.'}" FontSize="23" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource 'Haz clic donde quieras escribir y mantén el atajo mientras hablas. Al soltar, tu texto aparece allí.'}" Foreground="{DynamicResource Muted}" Margin="0,12,8,22" LineHeight="22" MaxWidth="400" HorizontalAlignment="Left" />
                  <Border Background="{DynamicResource GlassSurface}" CornerRadius="11" Padding="16,11" HorizontalAlignment="Left" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1">
                    <TextBlock Text="{Binding ActiveHotkey}" FontWeight="SemiBold" FontSize="14" />
                  </Border>
                  <StackPanel Orientation="Horizontal" Margin="0,17,0,0"><Ellipse Width="5" Height="5" Fill="{DynamicResource Positive}" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="{Binding StateLabel}" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite" /></StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                  <Border Width="142" Height="142" CornerRadius="40" Background="{DynamicResource GlassSurface}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-7" /></Border.RenderTransform></Border>
                  <Path Data="M 13,60 L 13,79 M 25,51 L 25,89 M 37,38 L 37,102 M 49,48 L 49,92 M 61,24 L 61,116 M 73,14 L 73,126 M 85,38 L 85,102 M 97,27 L 97,113 M 109,46 L 109,94 M 121,52 L 121,88 M 133,60 L 133,79" Stroke="{DynamicResource Accent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="146" Height="142" Opacity="0.85" />
                </Grid>
              </Grid>
            </Border>
            <Grid Margin="8,25,8,27">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{Binding TotalDictations}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource 'dictados guardados'}" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="{Binding TotalWords}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource 'palabras dictadas'}" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="{Binding TotalMinutes}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource 'minutos de voz'}" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
            </Grid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource 'Tu último dictado'}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource 'Tu próximo dictado aparecerá aquí. También podrás copiarlo o darle el último toque.'}" Foreground="{DynamicResource Muted}" Margin="0,12,0,5" LineHeight="21">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasLastText}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBox Text="{Binding LastText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0,15" FontSize="16" Visibility="{Binding HasLastText, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="{Binding LastRunDetails}" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="{Binding HasLastText, Converter={StaticResource BoolVisibility}}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasLastText, Converter={StaticResource BoolVisibility}}"><Button Content="{DynamicResource 'Copiar texto'}" Command="{Binding CopyLastCommand}" Padding="14,8" /><Button Content="{DynamicResource 'Corregir'}" Click="CorrectClicked" Margin="10,0,0,0" Padding="14,8" /></StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{DynamicResource 'Esc cancela el dictado. Cerrar esta ventana deja Senda en la bandeja.'}" Style="{StaticResource Caption}" Margin="2,17,0,0" />
          </StackPanel>
          <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource 'Tus palabras, a mano.'}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource 'Tus dictados de los últimos 30 días, guardados en este equipo.'}" Foreground="{DynamicResource Muted}" Margin="0,0,0,26" />
            <TextBlock Text="{DynamicResource 'Buscar en tus dictados'}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
            <DockPanel Margin="0,0,0,20"><Button Content="{DynamicResource 'Borrar historial'}" Command="{Binding ClearHistoryCommand}" DockPanel.Dock="Right" Margin="12,0,0,0" /><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource 'Buscar transcripciones'}" AutomationProperties.Name="{DynamicResource 'Buscar en historial'}" /></DockPanel>
            <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedEntry}" MaxHeight="440">
              <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Date}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,0,10" /><TextBlock Text="{Binding Text}" FontSize="15" LineHeight="23" /><TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,14,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border Margin="0,10,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{DynamicResource 'Todavía no hay palabras aquí.'}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource 'Prueba tu primer dictado o cambia la búsqueda. Puedes desactivar el historial en Ajustes.'}" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" /></StackPanel></Border>
            <Button Content="{DynamicResource 'Copiar seleccionado'}" Command="{Binding CopyHistoryCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
          </StackPanel>
          <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource 'A tu manera.'}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource 'Ajusta cómo se ve Senda y cómo escucha tu voz.'}" Foreground="{DynamicResource Muted}" Margin="0,0,0,26" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
              <TextBlock Text="{DynamicResource 'Un espacio cómodo'}" Style="{StaticResource SectionTitle}" />
              <Grid Margin="0,18,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource 'Idioma de la interfaz'}" VerticalAlignment="Center" Margin="0,0,16,0" /><ComboBox x:Name="InterfaceLanguagePicker" Grid.Column="1" ItemsSource="{Binding InterfaceLanguages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding InterfaceLanguage}" AutomationProperties.Name="{DynamicResource 'Idioma de la interfaz'}" /></Grid>
              <TextBlock Text="{DynamicResource 'Cambia los menús y mensajes. El idioma del dictado se elige por separado. Se aplica al guardar.'}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
              <Grid Margin="0,18,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{DynamicResource 'Apariencia'}" /><TextBlock Text="{DynamicResource 'Elige el tono que te acompaña.'}" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel><ComboBox x:Name="ThemePicker" Grid.Column="1" ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Theme}" AutomationProperties.Name="{DynamicResource 'Apariencia'}" /></Grid>
              <CheckBox Content="{DynamicResource 'Cristal y transparencias'}" IsChecked="{Binding UseGlassEffects}" />
              <TextBlock Text="{DynamicResource 'Windows adapta el efecto a tu equipo. Desactívalo para usar un fondo sólido. Los cambios se aplican al guardar.'}" Style="{StaticResource Caption}" Margin="30,0,0,0" LineHeight="19" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
              <TextBlock Text="{DynamicResource 'Modelo de voz'}" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding ModelName}" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
              <TextBlock Text="{Binding ModelPath}" FontSize="11" Foreground="{DynamicResource Subtle}" Margin="0,5,0,12" />
              <TextBlock Text="{DynamicResource 'Base consume menos recursos. Small puede mejorar el reconocimiento y la puntuación, a cambio de más memoria y tiempo. Ambos funcionan sin Internet tras la descarga.'}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,0,12" LineHeight="21" />
              <ComboBox x:Name="DownloadModelPicker" ItemsSource="{Binding DownloadModels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DownloadModelFile}" Margin="0,0,0,14" />
              <WrapPanel><Button Content="{DynamicResource 'Descargar modelo'}" Style="{StaticResource PrimaryButton}" Command="{Binding DownloadModelCommand}" Margin="0,0,10,0" /><Button Content="{DynamicResource 'Importar modelo'}" Command="{Binding ImportModelCommand}" ToolTip="{DynamicResource 'Importar un archivo Whisper GGML .bin'}" /></WrapPanel>
              <StackPanel Visibility="{Binding Downloading, Converter={StaticResource BoolVisibility}}" Margin="0,18,0,0"><ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100" /><Button Content="{DynamicResource 'Cancelar descarga'}" Command="{Binding CancelDownloadCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,6" /></StackPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
              <TextBlock Text="{DynamicResource 'Tu forma de dictar'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,18" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,18,18"><TextBlock Text="{DynamicResource 'Idioma'}" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language}" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,0,18">
                  <TextBlock Text="{DynamicResource 'Atajo al mantener pulsado'}" Margin="0,0,0,8" />
                  <ComboBox x:Name="HotkeyPicker" ItemsSource="{Binding HotkeyChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding HotkeyPreset}" IsEnabled="{Binding CanCaptureHotkey}" />
                  <StackPanel x:Name="CustomHotkeyPanel" Visibility="{Binding IsCustomHotkey, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
                    <TextBox x:Name="ShortcutCaptureBox" Text="{Binding HotkeyDisplay, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{DynamicResource 'Atajo personalizado'}" PreviewKeyDown="ShortcutKeyDown" PreviewKeyUp="ShortcutKeyUp" LostKeyboardFocus="ShortcutLostFocus" />
                    <Button x:Name="RecordHotkeyButton" Content="{Binding CaptureButtonText}" Click="RecordHotkeyClicked" IsEnabled="{Binding CanCaptureHotkey}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,7" />
                    <TextBlock Text="{DynamicResource 'Pulsa una combinación con Ctrl, Alt o Mayús y una tecla, o una tecla F1–F24. Esc cancela. Después guarda los ajustes.'}" Style="{StaticResource Caption}" Margin="0,9,0,0" />
                    <TextBlock Text="{Binding ShortcutError}" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,7,0,0" />
                  </StackPanel>
                  <TextBlock Text="{DynamicResource 'Puede coincidir con atajos de otras aplicaciones. Elige una combinación que no utilices para otra acción.'}" Style="{StaticResource Caption}" Margin="0,9,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,18"><TextBlock Text="{DynamicResource 'Micrófono'}" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding Microphones}" DisplayMemberPath="Name" SelectedValuePath="Index" SelectedValue="{Binding MicrophoneIndex}" /></StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,18,0"><TextBlock Text="{DynamicResource 'Hilos de CPU'}" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding ThreadOptions}" SelectedItem="{Binding CpuThreads}" /><TextBlock Text="{DynamicResource 'Más hilos pueden aumentar el consumo. El valor inicial se conserva.'}" Style="{StaticResource Caption}" Margin="0,7,0,0" /></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="{DynamicResource 'Liberar modelo tras inactividad'}" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding UnloadOptions}" SelectedItem="{Binding UnloadMinutes}" /><TextBlock Text="{DynamicResource 'Minutos sin dictar'}" Style="{StaticResource Caption}" Margin="0,7,0,0" /></StackPanel>
              </Grid>
              <TextBlock Text="{DynamicResource 'Aceleración'}" Margin="0,20,0,8" />
              <ComboBox x:Name="AccelerationPicker" ItemsSource="{Binding AccelerationModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Acceleration}" />
              <TextBlock Text="{DynamicResource 'GPU utiliza Vulkan con tarjetas AMD, NVIDIA o Intel compatibles. Si Vulkan no está disponible, se intenta usar CPU. Guarda y reinicia Senda para cambiar el modo.'}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
              <TextBlock Text="{DynamicResource 'La primera transcripción carga el modelo. Aumentar los minutos de inactividad evita recargas frecuentes, a cambio de mantenerlo en memoria.'}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
              <CheckBox Content="{DynamicResource 'Guiar puntuación (experimental)'}" IsChecked="{Binding UsePunctuationPrompt}" Margin="0,18,0,4" />
              <TextBlock Text="{DynamicResource 'Elige Español o English para usar esta ayuda. Puede mejorar la puntuación, pero también introducir errores. Con detección automática no se aplica.'}" Style="{StaticResource Caption}" Margin="30,0,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel>
              <TextBlock Text="{DynamicResource 'Privacidad y segundo plano'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
              <CheckBox Content="{DynamicResource 'Guardar historial local durante 30 días'}" IsChecked="{Binding SaveHistory}" />
              <TextBlock Text="{DynamicResource 'Al desactivarlo y guardar, se elimina el historial existente. El audio se descarta siempre.'}" Style="{StaticResource Caption}" Margin="30,0,0,9" LineHeight="19" />
              <CheckBox Content="{DynamicResource 'Iniciar en la bandeja al entrar en Windows'}" IsChecked="{Binding LaunchAtLogin}" />
            </StackPanel></Border>
            <Button Content="{DynamicResource 'Guardar ajustes'}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="2,15,0,0" Margin="0,22,0,0"><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite" /></Border>
    </Grid>
  </Grid>
</Window>
